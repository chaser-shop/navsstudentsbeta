{
  "name": "diary-web",
  "version": "2.0.0",
  "description": "Щоденник студента та електронний журнал успішності — вебверсія й сервер (Node.js + MongoDB + Web Push)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "dev:memory": "node scripts/dev-memory.js",
    "make-admin": "node scripts/make-admin.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report test/reports/playwright",
    "pw:install": "playwright install chromium"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "mongodb": "^6.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "mongodb-memory-server-core": "^10.4.3",
    "playwright": "^1.65.1"
  }
}
