+    gift = referral.attach(db, 2, 1)
+    assert gift and gift["code"].startswith("REF-") and gift["percent"] == 3
+    assert db.users.find_one({"_id": 2})["referred_by"] == 1
+    assert referral.attach(db, 2, 3) is None                    # вдруге запросити не можна
